<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Cerebellum Academy — APK Reconstruction</title>
<style>
:root{
 --navy:#0b1b38; --navy2:#142735; --ink:#17243a; --muted:#6b7280;
 --line:#e6e8ec; --paper:#f7f8fb; --white:#fff; --blue:#2683e2;
 --cyan:#24b0e6; --green:#16a34a; --red:#ef4444; --orange:#f59e0b;
 --radius:18px; --shadow:0 8px 30px rgba(11,27,56,.08);
}
*{box-sizing:border-box}
html,body{margin:0;background:var(--paper);color:var(--ink);font-family:Inter,Arial,sans-serif}
body{min-height:100vh}
button{font:inherit}
.app{max-width:520px;min-height:100vh;margin:0 auto;background:#fff;position:relative;box-shadow:0 0 50px rgba(0,0,0,.08)}
.topbar{height:64px;padding:12px 16px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);background:#fff;position:sticky;top:0;z-index:20}
.brand{display:flex;align-items:center;gap:10px;font-weight:700;color:var(--navy)}
.brand img{width:34px;height:34px;object-fit:contain}
.iconbtn{width:38px;height:38px;border:0;background:#f3f5f8;border-radius:12px;color:var(--navy);cursor:pointer}
.content{padding:16px 16px 92px}
.hero{background:linear-gradient(135deg,#0b1b38,#17395d);color:#fff;border-radius:22px;padding:20px;min-height:230px;position:relative;overflow:hidden;display:flex;align-items:flex-end}
.hero img{position:absolute;right:4px;bottom:-4px;height:225px;width:auto;opacity:.98}
.hero-copy{position:relative;z-index:1;max-width:58%}
.eyebrow{font-size:12px;opacity:.75;text-transform:uppercase;letter-spacing:.08em}
.hero h1{font-family:OpenSauceOne,Inter,sans-serif;font-size:28px;line-height:1.08;margin:7px 0}
.hero p{font-size:13px;line-height:1.45;opacity:.85;margin:0}
.section-head{display:flex;align-items:center;justify-content:space-between;margin:22px 2px 10px}
.section-head h2{font-size:18px;margin:0;color:var(--navy)}
.section-head span{font-size:12px;color:var(--muted)}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.card{background:#fff;border:1px solid var(--line);border-radius:18px;box-shadow:var(--shadow);padding:14px}
.module{min-height:158px;display:flex;flex-direction:column;justify-content:space-between;cursor:pointer}
.module img{height:82px;width:100%;object-fit:contain;object-position:right bottom}
.module h3{font-size:14px;margin:8px 0 0;color:var(--navy)}
.module p{font-size:11px;color:var(--muted);margin:5px 0 0}
.list{display:grid;gap:10px}
.row{display:flex;align-items:center;gap:12px;padding:14px;border:1px solid var(--line);border-radius:16px;background:#fff;cursor:pointer}
.thumb{width:54px;height:54px;border-radius:14px;object-fit:cover;background:#eef2f7;flex:none}
.row .grow{flex:1;min-width:0}
.row h3{font-size:14px;margin:0 0 4px;color:var(--navy)}
.row p{font-size:11px;color:var(--muted);margin:0}
.chev{color:#9aa3af}
.tabs{display:flex;gap:8px;overflow:auto;padding:3px 0 4px}
.tab{border:1px solid var(--line);background:#fff;border-radius:999px;padding:9px 13px;font-size:12px;white-space:nowrap;cursor:pointer}
.tab.active{background:var(--navy);border-color:var(--navy);color:#fff}
.subject-head{background:linear-gradient(180deg,#0b1b38,#17395d);color:#fff;border-radius:20px;overflow:hidden}
.subject-head img{display:block;width:100%;height:170px;object-fit:cover;opacity:.9}
.subject-head .pad{padding:16px}
.subject-head h1{font-family:OpenSauceOne,Inter,sans-serif;font-size:23px;margin:0 0 5px}
.subject-head p{font-size:12px;opacity:.75;margin:0}
.prof{display:flex;align-items:center;justify-content:space-between;background:#fff;border:1px solid var(--line);border-radius:15px;padding:13px 14px;margin-bottom:8px;cursor:pointer}
.prof strong{font-size:14px;color:var(--navy)}
.chapter{padding:12px 14px;border:1px solid var(--line);border-radius:13px;margin:6px 0;background:#fbfcfe;display:none}
.prof.open + .chapter-wrap .chapter{display:flex;align-items:center;justify-content:space-between}
.qcard{background:#fff;border:1px solid var(--line);border-radius:18px;padding:16px;box-shadow:var(--shadow)}
.qmeta{font-size:11px;color:var(--muted);margin-bottom:12px}
.qtext{font-family:OpenSauceOne,Inter,sans-serif;font-size:16px;line-height:1.5;color:var(--navy);margin-bottom:14px}
.option{border:1px solid #d9dee7;border-radius:13px;padding:13px;margin:8px 0;font-size:13px;cursor:pointer;transition:.15s}
.option.selected{border-color:#2683e2;background:#eaf4ff}
.option.correct{border-color:#16a34a;background:#ecfdf3}
.option.wrong{border-color:#ef4444;background:#fff1f2}
.option.locked{cursor:default}
.expl{display:none;margin-top:14px;padding:13px;border-radius:13px;background:#f5f7fa;font-size:12px;line-height:1.55}
.expl.show{display:block}
.bottomnav{position:fixed;bottom:0;left:50%;transform:translateX(-50%);width:min(520px,100%);height:74px;background:#fff;border-top:1px solid var(--line);display:grid;grid-template-columns:repeat(5,1fr);z-index:30}
.navitem{border:0;background:#fff;font-size:10px;color:#788191;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;cursor:pointer}
.navitem.active{color:var(--navy);font-weight:700}
.navicon{font-size:20px;line-height:1}
.profile-card{border-radius:20px;overflow:hidden;background:var(--navy);color:#fff;position:relative;min-height:180px}
.profile-card img.bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.7}
.profile-content{position:relative;padding:18px;display:flex;gap:14px;align-items:center}
.avatar{width:72px;height:72px;border-radius:50%;object-fit:cover;border:3px solid rgba(255,255,255,.8);background:#fff}
.profile-content h1{margin:0;font-size:20px}.profile-content p{margin:4px 0 0;font-size:12px;opacity:.75}
.statgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;margin-top:12px}
.stat{background:#fff;border:1px solid var(--line);border-radius:14px;padding:12px;text-align:center}
.stat b{display:block;font-size:17px;color:var(--navy)}.stat span{font-size:10px;color:var(--muted)}
.analytics{display:grid;gap:12px}.bar{height:10px;border-radius:99px;background:#e9edf2;overflow:hidden}.bar i{display:block;height:100%;background:#2683e2;border-radius:99px}
.video{background:#101820;border-radius:18px;overflow:hidden;color:#fff}.video img{width:100%;height:200px;object-fit:cover;opacity:.82}.video .vp{padding:14px}.video h3{margin:0 0 4px;font-size:15px}.video p{margin:0;font-size:11px;opacity:.65}
.hidden{display:none!important}
.debug{font-size:10px;color:#98a1ad;line-height:1.5;margin-top:20px}
@media(min-width:700px){body{background:#dfe5ec}.app{min-height:100vh}.content{padding-left:20px;padding-right:20px}}
</style>
<style>
@font-face{font-family:Inter;src:url(data:font/ttf;base64,) format("truetype");font-weight:400}
@font-face{font-family:Inter;src:url(data:font/ttf;base64,