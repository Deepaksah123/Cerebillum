","src_assets_images_telephone":"data:image/webp;base64,","src_assets_images_transparentlogo":"data:image/webp;base64,","src_assets_images_videoicon":"data:image/webp;base64,","src_assets_images_whatsapp":"data:image/webp;base64,"};
const ROUTES={"/home":2,"/qbank":15,"/pyq":2,"/grand-test":1,"/chapter":5,"/subject":10,"/video-category":3,"/video-category-units":1,"/live-tests":1,"/test":19,"/test-analytics":1,"/qbank/performance-analytics":1,"/notes":2,"/notes-page":1,"/flashcard":3,"/profile":1,"/plans":1,"/subscription":1};
const COMPONENTS={"HomePage":1,"CustomModule":29,"ChapterList":2,"QbankQuestions":4,"TestAnalytics":8,"Review":25,"Subject":96,"Video":196,"Profile":37,"Notes":36,"Flashcard":12,"PlanList":2};
const API={"/qbank":15,"/questions-data":1,"/question-details":1,"/questions":2,"/subject":10,"/subjects":1,"/chapter":5,"/subject-video-detail":1,"/video-category":3,"/video-category-units":1,"/video-session":1,"/latest-video-session":1,"/qbank-detail":1,"/qbank-annotations":1,"/qbank/performance-analytics":1,"/testSessions":1,"/test":19,"/test-analytics":1,"/session-result-summary":1,"/mock_test/session-result-summary":1,"/live-tests":1,"/grand-test":1,"/flashcard":3,"/notes-page":1,"/bookmarked-questions":2,"/bookmarked-videos":1,"/profile":1,"/user-profile/me":1,"/latest-session":1,"/attempted-question":2,"/subject-wise-qbank-analysis":1};
const API_BASE="https://app.cerebellumacademy.com/api/v1";

const esc=s=>String(s).replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[m]));
const asset=n=>A[n]||"";
const initialRoute=(location.hash&&location.hash.length>1)?decodeURIComponent(location.hash.slice(1)):"/home";\nconst state={route:initialRoute,qLocked:false,selected:null};

function nav(route){state.route=route;history.pushState({route}, "", "#"+encodeURIComponent(route));render();window.scrollTo({top:0,behavior:"instant"})}
function header(title="Cerebellum"){
 return `<div class="topbar"><button class="iconbtn" onclick="history.back()">‹</button><div class="brand"><img src="${asset("src_assets_images_transparentlogo")}" alt=""><span>${esc(title)}</span></div><button class="iconbtn" onclick="nav('/profile')">☻</button></div>`;
}
function bottom(active){
 const items=[["/home","⌂","Home"],["/qbank","▤","QBank"],["/test","◫","Test"],["/video-category","▶","Videos"],["/profile","●","Profile"]];
 return `<div class="bottomnav">${items.map(x=>`<button class="navitem ${active===x[0]?"active":""}" onclick="nav('${x[0]}')"><span class="navicon">${x[1]}</span>${x[2]}</button>`).join("")}</div>`;
}

function home(){
 const mods=[
  ["src_assets_images_custommodule_qbankquestions","QBank","Practice questions"],
  ["src_assets_images_custommodule_previousyearquestions","Previous Year","PYQs"],
  ["src_assets_images_custommodule_grandtestquestions","Grand Test","Exam simulation"],
  ["src_assets_images_custommodule_allquestions","All Questions","Complete bank"]
 ];
 return header("Home")+`<main class="content">
 <section class="hero"><div class="hero-copy"><div class="eyebrow">Cerebellum Academy</div><h1>Master your passion.</h1><p>Recorded lectures, QBank, tests and revision resources — reconstructed from the original APK client.</p></div><img src="${asset("src_assets_images_heroimg_homepage")}"></section>
 <div class="section-head"><h2>Quick access</h2><span>Original app assets</span></div>
 <div class="grid2">${mods.map(m=>`<article class="card module" onclick="nav('${m[1]==="QBank"?"/qbank":m[1]==="Grand Test"?"/grand-test":"/pyq"}')"><img src="${asset(m[0])}"><div><h3>${m[1]}</h3><p>${m[2]}</p></div></article>`).join("")}</div>
 <div class="section-head"><h2>Learning</h2><span>19 subjects</span></div>
 <div class="list">
  <div class="row" onclick="nav('/subject')"><img class="thumb" src="${asset("src_assets_images_subjectdetailbackground")}"><div class="grow"><h3>Subject-wise learning</h3><p>Subjects → chapters → videos / QBank</p></div><b class="chev">›</b></div>
  <div class="row" onclick="nav('/video-category')"><img class="thumb" src="${asset("src_assets_images_videoicon")}"><div class="grow"><h3>Recorded Videos</h3><p>Video categories and units</p></div><b class="chev">›</b></div>
  <div class="row" onclick="nav('/notes')"><img class="thumb" src="${asset("src_assets_images_notesicon")}"><div class="grow"><h3>Notes</h3><p>Notes and short notes</p></div><b class="chev">›</b></div>
 </div>
 <div class="debug">Evidence: HomePage=${COMPONENTS.HomePage||0}; API base=${esc(API_BASE)}</div>
 </main>${bottom("/home")}`;
}

function qbank(){
 return header("Question Bank")+`<main class="content">
 <div class="section-head"><h2>Question Bank</h2><span>Practice</span></div>
 <div class="tabs"><button class="tab active">All</button><button class="tab">PYQ</button><button class="tab">Custom</button><button class="tab">Bookmarked</button></div>
 <div class="section-head"><h2>Subjects</h2><span>19</span></div>
 <div class="list">${["Anatomy","Physiology","Biochemistry","Pathology","Pharmacology","Microbiology","Medicine","Surgery","Pediatrics","OBGYN","Ophthalmology","ENT"].map((s,i)=>`<div class="row" onclick="nav('/chapter')"><img class="thumb" src="${asset(i%2?"src_assets_images_question":"src_assets_images_marks")}"><div class="grow"><h3>${s}</h3><p>Chapters · Questions · Progress</p></div><b class="chev">›</b></div>`).join("")}</div>
 </main>${bottom("/qbank")}`;
}

function chapter(){
 return header("Anatomy")+`<main class="content">
 <section class="subject-head"><img src="${asset("src_assets_images_subjectdetailbackground")}"><div class="pad"><h1>Anatomy</h1><p>Subject detail · chapters · question bank · videos</p></div></section>
 <div class="section-head"><h2>Modules</h2><span>Expand / collapse</span></div>
 ${["1st Prof","2nd Prof","3rd Prof"].map((p,idx)=>`<div class="prof" onclick="this.classList.toggle('open')"><strong>${p}</strong><span>⌄</span></div><div class="chapter-wrap">${["General Anatomy","Upper Limb","Thorax","Abdomen","Neuroanatomy"].slice(0,idx+3).map(c=>`<div class="chapter"><span>${c}</span><span>›</span></div>`).join("")}</div>`).join("")}
 <div class="section-head"><h2>Practice</h2></div><div class="grid2">
 <div class="card module" onclick="nav('/qbank-question')"><img src="${asset("src_assets_images_custommodule_qbankquestions")}"><h3>QBank Questions</h3></div>
 <div class="card module" onclick="nav('/video-category')"><img src="${asset("src_assets_images_image3")}"><h3>Videos</h3></div>
 </div></main>${bottom("/qbank")}`;
}

function question(){
 return header("QBank Question")+`<main class="content"><div class="qcard">
 <div class="qmeta">Anatomy · PYQ · Question 1</div>
 <div class="qtext">A structure passes through the greater sciatic foramen. Which of the following relationships is correct?</div>
 <div id="opts">${["Piriformis divides the foramen into two parts","Obturator internus passes through it","Gluteus maximus forms its superior boundary","Sciatic nerve passes anterior to piriformis"].map((o,i)=>`<div class="option" onclick="answer(${i},this)">${String.fromCharCode(65+i)}. ${o}</div>`).join("")}</div>
 <div id="expl" class="expl"><b>Explanation</b><br>Explanation area is intentionally interactive and hidden until an option is selected, matching the question-bank interaction model recovered from the client.</div>
 </div></main>${bottom("/qbank")}`;
}
function answer(i,el){
 if(state.qLocked)return;
 state.qLocked=true;state.selected=i;
 document.querySelectorAll(".option").forEach((x,j)=>{x.classList.add("locked");if(j===0)x.classList.add("correct");});
 if(i!==0)el.classList.add("wrong");
 document.getElementById("expl").classList.add("show");
}

function tests(){
 return header("Test")+`<main class="content">
 <div class="section-head"><h2>Tests</h2><span>Assessment</span></div>
 <div class="grid2">
 <div class="card module" onclick="nav('/test-instructions')"><img src="${asset("src_assets_images_custommodule_grandtestquestions")}"><h3>Grand Test</h3><p>Exam simulation</p></div>
 <div class="card module" onclick="nav('/test-instructions')"><img src="${asset("src_assets_images_custommodule_allquestions")}"><h3>Subject Test</h3><p>Timed assessment</p></div>
 </div>
 <div class="section-head"><h2>Analytics</h2></div>
 <div class="card analytics"><div><b>Accuracy</b><div class="bar"><i style="width:72%"></i></div></div><div><b>Attempted</b><div class="bar"><i style="width:48%"></i></div></div><div><b>Revision</b><div class="bar"><i style="width:61%"></i></div></div></div>
 </main>${bottom("/test")}`;
}
function instructions(){
 return header("Instructions")+`<main class="content">
 <div class="card"><h2 style="margin-top:0;color:var(--navy)">Test Instructions</h2><p style="font-size:13px;line-height:1.6;color:var(--muted)">Read the instructions before starting. The original app exposes a dedicated instruction window before a test session.</p>
 <div class="list"><div class="row"><div class="grow"><h3>Total Questions</h3><p>100</p></div></div><div class="row"><div class="grow"><h3>Duration</h3><p>120 minutes</p></div></div><div class="row"><div class="grow"><h3>Marking</h3><p>Correct / incorrect / unanswered</p></div></div></div>
 <button onclick="nav('/test-analytics')" style="width:100%;margin-top:16px;border:0;border-radius:14px;background:var(--navy);color:#fff;padding:14px;font-weight:700">Start Test</button></div>
 </main>${bottom("/test")}`;
}
function analytics(){return header("Test Analytics")+`<main class="content"><div class="section-head"><h2>Result & Analysis</h2></div><div class="statgrid"><div class="stat"><b>72%</b><span>Accuracy</span></div><div class="stat"><b>81</b><span>Correct</span></div><div class="stat"><b>19</b><span>Wrong</span></div></div><div class="section-head"><h2>Performance</h2></div><div class="card"><img style="width:100%" src="${asset("src_assets_images_lockedgraph")}"><p style="font-size:11px;color:var(--muted)">Analytics visual recovered from APK resources.</p></div></main>${bottom("/test")}`}

function videos(){return header("Videos")+`<main class="content"><div class="tabs"><button class="tab active">All</button><button class="tab">Main</button><button class="tab">Rapid Revision</button><button class="tab">PYQ</button></div><div class="section-head"><h2>Video categories</h2></div><div class="list">${["Main Videos","Rapid Revision","PYQ Discussion","Live Sessions"].map((x,i)=>`<div class="video"><img src="${asset(["src_assets_images_samplecoverimage","src_assets_images_homepage_2","src_assets_images_homepage_3","src_assets_images_liveicon"][i])}"><div class="vp"><h3>${x}</h3><p>Category → units → video sessions</p></div></div>`).join("")}</div></main>${bottom("/video-category")}`}

function notes(){return header("Notes")+`<main class="content"><div class="section-head"><h2>Notes</h2></div><div class="card"><img style="width:100%;max-height:310px;object-fit:contain" src="${asset("src_assets_images_notesoverlay")}"><h3 style="color:var(--navy)">Study Notes</h3><p style="font-size:12px;color:var(--muted)">Notes-related UI assets recovered directly from the APK.</p></div><div class="row" onclick="nav('/flashcard')"><img class="thumb" src="${asset("src_assets_images_language_2")}"><div class="grow"><h3>Flashcards</h3><p>Active recall / Codons</p></div><b>›</b></div></main>${bottom("/notes")}`}

function flash(){return header("Flashcards")+`<main class="content"><div class="card" style="min-height:330px;display:flex;flex-direction:column;justify-content:center;text-align:center"><img style="height:170px;object-fit:contain" src="${asset("src_assets_images_personalizedlearning")}"><h2 style="color:var(--navy)">Flashcards</h2><p style="font-size:12px;color:var(--muted)">Card interaction shell recovered from the module/asset evidence.</p><button onclick="this.textContent=this.textContent==='Show Answer'?'Hide Answer':'Show Answer'" style="border:0;border-radius:12px;padding:12px;background:var(--navy);color:#fff">Show Answer</button></div></main>${bottom("/notes")}`}

function profile(){return header("Profile")+`<main class="content"><section class="profile-card"><img class="bg" src="${asset("src_assets_images_profilecardbg")}"><div class="profile-content"><img class="avatar" src="${asset("src_assets_images_defaultuserprofile")}"><div><h1>Student Profile</h1><p>Account · subscription · progress</p></div></div></section><div class="statgrid"><div class="stat"><b>19</b><span>Subjects</span></div><div class="stat"><b>0</b><span>Streak</span></div><div class="stat"><b>0</b><span>Tests</span></div></div><div class="section-head"><h2>Account</h2></div><div class="list">${["Subscription","Plans","Bookmarks","Performance Analytics"].map((x,i)=>`<div class="row" onclick="nav('${["/subscription","/plans","/qbank","/qbank/performance-analytics"][i]}')"><div class="grow"><h3>${x}</h3><p>Open ${x.toLowerCase()}</p></div><b>›</b></div>`).join("")}</div></main>${bottom("/profile")}`}

function generic(title,desc,img){
 return header(title)+`<main class="content"><div class="card"><img style="width:100%;max-height:300px;object-fit:contain" src="${asset(img)}"><h2 style="color:var(--navy)">${title}</h2><p style="font-size:13px;color:var(--muted);line-height:1.5">${desc}</p></div></main>${bottom("")}`;
}
function render(){
 let h;
 switch(state.route){
  case "/home":h=home();break; case "/qbank":h=qbank();break; case "/chapter":
  case "/subject":h=chapter();break; case "/qbank-question":h=question();break;
  case "/test":h=tests();break; case "/test-instructions":h=instructions();break;
  case "/test-analytics":h=analytics();break; case "/video-category":
  case "/video-category-units":h=videos();break; case "/notes":
  case "/notes-page":h=notes();break; case "/flashcard":h=flash();break;
  case "/profile":h=profile();break; case "/pyq":h=generic("Previous Year Questions","Year-wise / subject-wise PYQ module.","src_assets_images_custommodule_previousyearquestions");break;
  case "/grand-test":h=generic("Grand Test","Grand-test entry point recovered from the APK navigation vocabulary.","src_assets_images_custommodule_grandtestquestions");break;
  case "/plans":h=generic("Plans","Subscription and plan UI entry point.","src_assets_images_planspage_plans_illustration");break;
  case "/subscription":h=generic("Subscription","Subscription state and plan management entry point.","src_assets_images_subscription");break;
  default:h=generic(state.route,"Route recovered from the APK bundle.","src_assets_images_logo");
 }
 document.getElementById("app").innerHTML=h;
}
window.addEventListener("popstate",()=>{state.route=(location.hash&&location.hash.length>1)?decodeURIComponent(location.hash.slice(1)):"/home";render()});\nwindow.addEventListener("hashchange",()=>{state.route=(location.hash&&location.hash.length>1)?decodeURIComponent(location.hash.slice(1)):"/home";render()});\nrender();
</script>
</body>
</html>